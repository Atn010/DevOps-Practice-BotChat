      "typeVersion": 1,
      "credentials": {
        "githubApi": {
          "id": "PdP0LLO5aC8NqY7E",
          "name": "GitHub account"
        }
      }
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/{{$json.body.sender.login}}/{{$json.body.repository.name}}/pulls/{{$json.body.number}}/files",
        "options": {}
      },
      "id": "25d17a0d-c409-406d-bd97-00ec71261c16",
      "name": "Get file's Diffs from PR",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        736,
        432
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const files = $input.all().map(item => item.json);\n\nlet diffs = '';\n\nfor (const file of files) {\n  diffs += `### Fichier : ${file.filename}\\n\\n`;\n\n  if (file.patch) {\n    // IMPORTANT : On remplace tous les triple backticks par simple (ou échappement)\n    const safePatch = file.patch.replace(/```/g, \"''\");\n\n    diffs += \"```diff\\n\";\n    diffs += safePatch;\n    diffs += \"\\n```\\n\";\n  } else {\n    diffs += \"_Pas de patch disponible (probablement fichier binaire)._\";\n  }\n\n  diffs += \"\\n---\\n\\n\";\n}\n\nconst userMessage = `\nAct as a Senior iOS Engineer specialized in Swift and SwiftUI. Perform a thorough code review of the provided SwiftUI code snippet.\n\nYour review should cover the following areas:\n\n**1. Architecture and Best Practices:**\n*   Identify any architectural smells or anti-patterns (e.g., massive views, excessive logic in the View struct).\n*   Assess the use of the MVVM or similar pattern, ensuring state management is clean (using @State, @ObservedObject, @StateObject, @EnvironmentObject appropriately).\n*   Check for adherence to Apple's Human Interface Guidelines and SwiftUI conventions.\n\n**2. Performance and Optimization:**\n*   Identify potential performance bottlenecks (e.g., unnecessary view redraws, heavy computations in \\`body\\` or \\`onChange\\`).\n*   Suggest ways to optimize views for faster loading and smoother interactions.\n\n**3. Code Quality and Readability:**\n*   Point out naming convention issues (e.g., variable, function, and view names).\n*   Assess code clarity, commenting, and overall maintainability.\n*   Check for deep view nesting that could affect readability.\n\n**4. Error Handling and Stability:**\n*   Flag potential crashes or runtime errors (e.g., force unwrapping, nil coalescing issues).\n*   Suggest robust error handling strategies, especially for networking or data operations.\n\n**5. Modern Swift/SwiftUI Features:**\n*   Recommend the use of modern Swift concurrency features (async/await) where applicable.\n*   Ensure the code uses the latest APIs and patterns, such as the \\`@Observable\\` macro (iOS 17+) if appropriate for the project's target deployment.\n\n**Format your response with:**\n*   A brief overall summary of the code quality.\n*   Specific, actionable suggestions listed using bullet points under each category.\n*   Code examples for how to fix problematic areas.\n\n${diffs}\n\n---\n\nYour mission:\n\n- Review the proposed code changes file by file and by significant modification.\n\n- Generate inline comments on the relevant lines of code.\n\n- Ignore files without patches.\n\n- Do not repeat the code snippet or the filename.\n\n- Write the comments directly, without introducing the context.\n`;\n\nreturn [\n  {\n    json: {\n      user_message: userMessage.trim()\n    }\n  }\n];"
      },
